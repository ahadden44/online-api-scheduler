# Leave these blank to run the Northline preview practice.
# Fill them in to read and write a real Tebra account.

TEBRA_CUSTOMER_KEY=
TEBRA_USER=
TEBRA_PASSWORD=
TEBRA_PRACTICE_NAME=
TEBRA_PRACTICE_ID=
TEBRA_DEFAULT_SERVICE_LOCATION_ID=
TEBRA_ENDPOINT=https://webservice.kareo.com/services/soap/2.1/KareoServices.svc

# Wall-clock zone for posted hours. Tebra itself is called in UTC.
PRACTICE_TIMEZONE=America/New_York

# Required to open /board and to save hours. Set this on the scheduler host, not in the practice website.
STAFF_CODE=
